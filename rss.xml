---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} — Daily AI Notes</title>
    <link>{{ '/notes/' | absolute_url }}</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>en</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ '/rss.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    {% for post in site.posts limit: 50 %}
    {% assign rss_text = post.summary | default: post.excerpt | strip_html %}
    {% for ref in post.references %}
      {% assign rss_text = rss_text | append: " — " | append: ref.title | append: " (" | append: ref.url | append: ")" %}
    {% endfor %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ rss_text | xml_escape }}</description>
      {% for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
