---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }} — Daily AI Notes</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/notes/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/notes/' | absolute_url | xml_escape }}</id>
  <updated>{% if site.posts.first %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author>
    <name>{{ site.title | xml_escape }}</name>
  </author>
  {% for post in site.posts limit: 50 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary type="text">{{ post.summary | default: post.excerpt | strip_html | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {% endfor %}
    {% for ref in post.references %}
    <link rel="related" href="{{ ref.url | xml_escape }}" title="{{ ref.title | xml_escape }}"/>
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
